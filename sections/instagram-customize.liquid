<!-- instagram-customize.liquid -->
{%-  liquid 
  case section.settings.image_size 
  when 'square' 
    assign himg = '100%' 
    when 'portrait' 
      assign himg = '120%' 
    when 'wide' 
      assign himg = '56%' 
    when 'landscape' 
      assign himg = '75%' 
  else
    assign himg = '100%' 
  endcase 
-%}
{%- assign _pg = section.settings.post_gap | default: 0 -%}
{%- assign _pr = section.settings.post_radius | default: 0 -%}
{%- if section.settings.top_divider or _pg > 0 or _pr > 0 -%}
<style>
{%- if section.settings.top_divider %}.customstyle{{ section.id }}{ border-top: 1px solid {{ section.settings.divider_color | default: '#ececec' }}; }{% endif %}
{%- if _pg > 0 %}.customstyle{{ section.id }} .instagramoff-item{ margin-left: {{ _pg | divided_by: 2.0 }}px; margin-right: {{ _pg | divided_by: 2.0 }}px; }{% endif %}
{%- if _pr > 0 %}.customstyle{{ section.id }} .instagramoff-item{ border-radius: {{ _pr }}px; overflow: hidden; }{% endif %}
</style>
{%- endif -%}
<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}" style="--h-image-insta:{{ himg }};">
  <div class="{{ section.settings.setwidth }}">
    {%- render 'style-section' -%}
  <div class="section-block">
    {%- if section.settings.show_ig_icon -%}
      {%- assign _iglink = section.settings.ig_link | default: 'https://www.instagram.com/fegelcomfort' -%}
      {%- assign _ighandle = section.settings.ig_handle | default: '@fegelcomfort' -%}
      {%- assign _al = section.settings['align-heading'] -%}
      {%- assign _igcolor = section.settings.ig_icon_color | default: '#b8860b' -%}
      <style>
        .ig-head-{{ section.id }} { display:flex; align-items:center; gap:16px; margin:0 0 26px; {% if _al == 'center' %}justify-content:center;{% elsif _al == 'right' %}justify-content:flex-end;{% else %}justify-content:flex-start;{% endif %} }
        .ig-badge-{{ section.id }} { display:inline-flex; align-items:center; justify-content:center; width:52px; height:52px; border-radius:50%; border:1px solid {{ _igcolor }}; color:{{ _igcolor }}; flex:0 0 auto; transition:background .4s cubic-bezier(.19,1,.22,1), color .4s cubic-bezier(.19,1,.22,1), transform .4s cubic-bezier(.19,1,.22,1); text-decoration:none; }
        .ig-badge-{{ section.id }}:hover { background:{{ _igcolor }}; color:#fff; transform:translateY(-2px); }
        .ig-badge-{{ section.id }} svg { width:26px; height:26px; display:block; }
        .ig-badge-{{ section.id }} svg, .ig-badge-{{ section.id }} svg * { fill:none !important; stroke:currentColor !important; }
        .ig-head-{{ section.id }} .section-title-1 { margin:0; }
        .ig-head-{{ section.id }} .ig-handle-link { text-decoration:none; color:inherit; }
      </style>
      <div class="ig-head-{{ section.id }}">
        <a href="{{ _iglink }}" target="_blank" rel="noopener" class="ig-badge-{{ section.id }}" aria-label="Instagram - {{ _ighandle | escape }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <h3 class="section-title-1"><a href="{{ _iglink }}" target="_blank" rel="noopener" class="ig-handle-link"><span>{{ _ighandle }}</span></a></h3>
      </div>
    {%- endif -%}
    {%- render 'section-heading' -%}
    <div class="instagramoff-wrapper dots-negative">
      <div class="instagramoff-slider mb-0  {% if section.settings.padding == false %} row mx-0 {% else %} row{% endif %}" id="service-list-{{ section.id }}"
           data-rows="{{ section.settings.rows }}"
           data-slidesToShow="{{ section.settings.show }}"
           data-slidestoscroll="1"
           data-arrows="{{ section.settings.arrows }}"
           data-dots="{{ section.settings.dots }}" 
           data-draggable="{{ section.settings.draggable }}" 
           data-infinite="{{ section.settings.infinite }}" 
           data-section-id="{{ section.id }}" 
           data-slidesToShow-mobile="2"
           data-section-type="slickCarousels">
        {%- for block in section.blocks -%}
          {% case block.type %}
            {% when 'image' %}
            <div class="{% if section.settings.padding == false %} col px-0 {% else %} col {% endif %}  carousel__slide-wrapper--{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="position-relative hv-image-brightness instagramoff-item"  data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}" >
                {%- if block.settings.image != blank -%}
                <a  href="{{ block.settings.image_link }}" title="{{ block.settings.image.alt | escape }}" class="image-content__image-wrapper" style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                  {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                  <img class="image-content__image lazyload transition"
                  src="{{ block.settings.image | image_url: width: 300, height: 300 }}"
                  data-src="{{ img_url }}"
                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                  data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                  data-sizes="auto"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}" >
                </a>
                {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
           {% when 'video' %}
           <div class="{% if section.settings.padding == false %} col px-0 {% else %} col {% endif %}  carousel__slide-wrapper--{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="position-relative hv-image-brightness instagramoff-item instagramoff-itemvideo"  data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}" >
              {%- if block.settings.video_url != blank -%}
              <a  href="{{ block.settings.image_link }}" class="d-block">
          <video id="video-insta{{ section.id }}" controls  loop="" muted="" playsinline="" {% if block.settings.enable_play_video %} autoplay {% else %} preload="none" {% endif %} disablepictureinpicture controlslist="nodownload noplaybackrate"
                {% if block.settings.image_poster != blank %} poster="{{ block.settings.image_poster | image_url: width: 1920 }}" {% endif %}>
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
              </a>
              {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
              
          {% endcase %}
        
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size == 0 -%}
    {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
</div>
</div>

