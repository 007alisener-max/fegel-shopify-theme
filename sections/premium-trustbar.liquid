{%- comment -%} premium-trustbar.liquid — Güven Şeridi (.ptb-) {%- endcomment -%}

{%- assign uid = section.id -%}

<style>
  .ptb-{{ uid }} {
    background: {{ section.settings.bg_color }};
    {% if section.settings.glass %}backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);{% endif %}
    border-top: 1px solid {{ section.settings.accent_color }}22;
    border-bottom: 1px solid {{ section.settings.accent_color }}22;
  }
  .ptb-{{ uid }} .ptb-wrap {
    max-width: 1320px; margin: 0 auto;
    padding: {{ section.settings.padding_y }}px 24px;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    align-items: center;
  }
  .ptb-{{ uid }} .ptb-item {
    display: flex; align-items: center; gap: 16px;
    padding: 6px 26px;
    position: relative;
    color: {{ section.settings.text_color }};
  }
  .ptb-{{ uid }} .ptb-item + .ptb-item::before {
    content: ""; position: absolute; left: 0; top: 50%;
    transform: translateY(-50%);
    width: 1px; height: 40px;
    background: {{ section.settings.text_color }}1f;
  }
  .ptb-{{ uid }} .ptb-icon {
    flex-shrink: 0; width: 34px; height: 34px;
    color: {{ section.settings.accent_color }};
    transition: transform .6s cubic-bezier(.19,1,.22,1);
  }
  .ptb-{{ uid }} .ptb-item:hover .ptb-icon { transform: translateY(-3px) scale(1.06); }
  .ptb-{{ uid }} .ptb-icon svg { width: 100%; height: 100%; display: block; }
  .ptb-{{ uid }} .ptb-txt { display: flex; flex-direction: column; gap: 3px; }
  .ptb-{{ uid }} .ptb-title {
    font-size: 12px; letter-spacing: .18em; text-transform: uppercase; font-weight: 700;
    line-height: 1.1;
  }
  .ptb-{{ uid }} .ptb-sub { font-size: 12.5px; opacity: .62; line-height: 1.3; }

  @media (max-width: 989px) {
    .ptb-{{ uid }} .ptb-wrap { grid-template-columns: repeat(2, 1fr); gap: 4px 0; }
    .ptb-{{ uid }} .ptb-item:nth-child(2n)::before,
    .ptb-{{ uid }} .ptb-item + .ptb-item::before { display: none; }
    .ptb-{{ uid }} .ptb-item { padding: 12px 16px; }
  }
  @media (max-width: 749px) {
    .ptb-{{ uid }} .ptb-item { gap: 12px; }
    .ptb-{{ uid }} .ptb-icon { width: 28px; height: 28px; }
  }
</style>

<div class="ptb-{{ uid }}">
  <div class="ptb-wrap">
    {%- for block in section.blocks -%}
      <div class="ptb-item" {{ block.shopify_attributes }}>
        <span class="ptb-icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'tools' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5a3.5 3.5 0 0 0 4.7 4.5l-8 8a2.1 2.1 0 0 1-3-3l8-8a3.5 3.5 0 0 0-1.7-1.5z"/><path d="M6 15l3 3"/></svg>
            {%- when 'headset' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M20 19a4 4 0 0 1-4 3h-2"/></svg>
            {%- when 'refund' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 1 2.5 5.8"/><path d="M4 20v-4h4"/></svg>
            {%- when 'card' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
          {%- endcase -%}
        </span>
        <span class="ptb-txt">
          {%- if block.settings.title != blank -%}<span class="ptb-title">{{ block.settings.title }}</span>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<span class="ptb-sub">{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Premium Güven Şeridi",
  "class": "index-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Arka Plan", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Yazı Rengi", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Vurgu (İkon) Rengi", "default": "#b8860b" },
    { "type": "checkbox", "id": "glass", "label": "Buz Camı Efekti", "default": false },
    {
      "type": "range", "id": "padding_y", "label": "Dikey Boşluk",
      "min": 8, "max": 48, "step": 2, "unit": "px", "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Güven Öğesi",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "İkon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Kamyon (Kargo)" },
            { "value": "shield", "label": "Kalkan (Garanti)" },
            { "value": "lock", "label": "Kilit (Güvenli Ödeme)" },
            { "value": "card", "label": "Kart (Ödeme)" },
            { "value": "tools", "label": "Anahtar (Kurulum)" },
            { "value": "headset", "label": "Kulaklık (Destek)" },
            { "value": "refund", "label": "İade" }
          ]
        },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Ücretsiz Kargo" },
        { "type": "text", "id": "subtitle", "label": "Alt Metin", "default": "Tüm Türkiye'ye" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Premium Güven Şeridi",
      "category": "Fegel Premium",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck",   "title": "Ücretsiz Kargo",  "subtitle": "Tüm Türkiye'ye" } },
        { "type": "item", "settings": { "icon": "shield",  "title": "2 Yıl Garanti",    "subtitle": "Resmi distribütör" } },
        { "type": "item", "settings": { "icon": "lock",    "title": "Güvenli Ödeme",    "subtitle": "256-bit SSL" } },
        { "type": "item", "settings": { "icon": "tools",   "title": "Kapıda Kurulum",   "subtitle": "Uzman ekip" } }
      ]
    }
  ]
}
{% endschema %}
