{%- comment -%} premium-testimonials.liquid {%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign pv = section.settings.per_view | default: 3 -%}
{%- assign pv_gaps = pv | minus: 1 -%}
{%- assign pv_totgap = section.settings.gap | times: pv_gaps -%}

<style>
  .pt-{{ uid }} {
    --pt-accent: {{ section.settings.accent_color }};
    background: {{ section.settings.section_bg }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    {%- if section.settings.top_divider %}border-top: 1px solid {{ section.settings.divider_color }};{% endif -%}
    overflow: hidden;
  }
  .pt-{{ uid }} .pt-inner { max-width: 1320px; margin: 0 auto; padding: 0 20px; }

  /* --- Başlık --- */
  .pt-{{ uid }} .pt-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 24px; margin-bottom: 44px;
  }
  .pt-{{ uid }} .pt-subheading {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 12px; letter-spacing: .25em; text-transform: uppercase; font-weight: 600;
    color: var(--pt-accent); margin-bottom: 14px;
  }
  .pt-{{ uid }} .pt-subheading::before { content: ""; width: 36px; height: 1px; background: var(--pt-accent); opacity: .6; }
  .pt-{{ uid }} .pt-heading { font-size: clamp(26px, 3.2vw, 42px); line-height: 1.15; margin: 0; }

  .pt-{{ uid }} .pt-arrows { display: flex; gap: 10px; flex-shrink: 0; }
  .pt-{{ uid }} .pt-arrow {
    width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: rgba(127,127,127,.08);
    border: 1px solid rgba(127,127,127,.2); color: inherit;
    transition: background .35s ease, border-color .35s ease, transform .3s ease, opacity .3s ease;
  }
  .pt-{{ uid }} .pt-arrow:hover { background: var(--pt-accent); border-color: var(--pt-accent); color: #fff; transform: scale(1.06); }
  .pt-{{ uid }} .pt-arrow svg { width: 18px; height: 18px; }
  .pt-{{ uid }} .pt-arrow:disabled { opacity: .3; pointer-events: none; }

  /* --- Kayan şerit --- */
  .pt-{{ uid }} .pt-track {
    display: flex; gap: {{ section.settings.gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 4px;
    margin: -4px;
    cursor: grab;
  }
  .pt-{{ uid }} .pt-track::-webkit-scrollbar { display: none; }
  .pt-{{ uid }} .pt-track.dragging { cursor: grabbing; scroll-snap-type: none; }
  .pt-{{ uid }} .pt-track.dragging .pt-card { pointer-events: none; }

  /* --- Kart --- */
  .pt-{{ uid }} .pt-card {
    flex: 0 0 calc((100% - {{ pv_totgap }}px) / {{ pv }});
    scroll-snap-align: start;
    position: relative;
    border-radius: {{ section.settings.radius }}px;
    padding: 34px 30px 30px;
    background: rgba({{ section.settings.card_bg.red }}, {{ section.settings.card_bg.green }}, {{ section.settings.card_bg.blue }}, .8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(127,127,127,.14);
    transition: transform .5s cubic-bezier(.19,1,.22,1), box-shadow .5s ease, border-color .4s ease;
  }
  .pt-{{ uid }} .pt-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 50px rgba(0,0,0,.1);
    border-color: rgba({{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }}, .45);
  }

  .pt-{{ uid }} .pt-quote-mark {
    position: absolute; top: 22px; right: 26px;
    font-size: 72px; line-height: 1; font-family: Georgia, serif;
    color: var(--pt-accent); opacity: .18; pointer-events: none;
  }
  .pt-{{ uid }} .pt-stars { display: flex; gap: 3px; margin-bottom: 16px; }
  .pt-{{ uid }} .pt-stars svg { width: 15px; height: 15px; fill: var(--pt-accent); }
  .pt-{{ uid }} .pt-stars svg.off { fill: rgba(127,127,127,.25); }

  .pt-{{ uid }} .pt-text {
    font-size: 15px; line-height: 1.75; margin: 0 0 22px; opacity: .9;
  }
  .pt-{{ uid }} .pt-person { display: flex; align-items: center; gap: 14px; }
  .pt-{{ uid }} .pt-avatar {
    width: 46px; height: 46px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
    border: 1px solid rgba(127,127,127,.2);
  }
  .pt-{{ uid }} .pt-avatar-fallback {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--pt-accent); color: #fff;
    font-size: 16px; font-weight: 700;
  }
  .pt-{{ uid }} .pt-name { font-size: 14px; font-weight: 700; }
  .pt-{{ uid }} .pt-role {
    font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600;
    color: var(--pt-accent); margin-top: 3px;
  }

  @media (max-width: 989px) {
    .pt-{{ uid }} .pt-card { flex-basis: calc((100% - {{ section.settings.gap }}px) / 2); }
  }
  @media (max-width: 749px) {
    .pt-{{ uid }} { padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px; }
    .pt-{{ uid }} .pt-head { flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 28px; }
    .pt-{{ uid }} .pt-card { flex-basis: 86%; padding: 26px 22px 24px; }
  }
</style>

<div class="pt-{{ uid }}">
  <div class="pt-inner">

    <div class="pt-head">
      <div>
        {%- if section.settings.subheading != blank -%}
          <div class="pt-subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pt-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      <div class="pt-arrows">
        <button class="pt-arrow" data-pt-prev aria-label="Önceki yorumlar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>
        <button class="pt-arrow" data-pt-next aria-label="Sonraki yorumlar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="pt-track" id="PtTrack-{{ uid }}">
      {%- for block in section.blocks -%}
        <div class="pt-card" {{ block.shopify_attributes }}>
          <span class="pt-quote-mark">&ldquo;</span>

          <div class="pt-stars" aria-label="{{ block.settings.rating }} yıldız">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" {% if i > block.settings.rating %}class="off"{% endif %}>
                <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/>
              </svg>
            {%- endfor -%}
          </div>

          {%- if block.settings.text != blank -%}
            <p class="pt-text">{{ block.settings.text }}</p>
          {%- endif -%}

          <div class="pt-person">
            {%- if block.settings.avatar != blank -%}
              <img class="pt-avatar" src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name | escape }}" width="46" height="46" loading="lazy">
            {%- else -%}
              <span class="pt-avatar-fallback">{{ block.settings.name | slice: 0 | upcase | default: '?' }}</span>
            {%- endif -%}
            <div>
              <div class="pt-name">{{ block.settings.name }}</div>
              {%- if block.settings.role != blank -%}
                <div class="pt-role">{{ block.settings.role }}</div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('PtTrack-{{ uid }}');
    if (!track || track.dataset.init) return;
    track.dataset.init = '1';

    var root = track.closest('.pt-{{ uid }}');
    var prev = root.querySelector('[data-pt-prev]');
    var next = root.querySelector('[data-pt-next]');

    function step() {
      var card = track.querySelector('.pt-card');
      return card ? card.offsetWidth + {{ section.settings.gap }} : 320;
    }
    function updateArrows() {
      prev.disabled = track.scrollLeft <= 5;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
    }

    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', updateArrows, { passive: true });

    /* Fareyle sürükleme */
    var isDown = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse') return;
      isDown = true; moved = false;
      startX = e.clientX; startScroll = track.scrollLeft;
    });
    window.addEventListener('pointermove', function (e) {
      if (!isDown) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 5) { moved = true; track.classList.add('dragging'); }
      track.scrollLeft = startScroll - dx;
    });
    window.addEventListener('pointerup', function () {
      isDown = false;
      setTimeout(function () { track.classList.remove('dragging'); }, 50);
    });

    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "Premium Yorumlar",
  "class": "index-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst Başlık", "default": "Müşterilerimiz" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bizi Tercih Edenler" },
    {
      "type": "range", "id": "per_view", "label": "Masaüstünde Görünen Kart (adet)",
      "min": 2, "max": 5, "step": 1, "default": 3
    },
    {
      "type": "range", "id": "gap", "label": "Kartlar Arası Boşluk",
      "min": 12, "max": 40, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range", "id": "radius", "label": "Köşe Yuvarlama",
      "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18
    },
    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "section_bg", "label": "Bölüm Arkaplanı", "default": "#faf8f5" },
    { "type": "color", "id": "card_bg", "label": "Kart Arkaplanı", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Yazı Rengi", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Vurgu Rengi", "default": "#b8860b" },
    { "type": "checkbox", "id": "top_divider", "label": "Üst ayrım çizgisi", "default": true },
    { "type": "color", "id": "divider_color", "label": "Ayrım çizgisi rengi", "default": "#ececec" },
    { "type": "header", "content": "Boşluklar" },
    {
      "type": "range", "id": "padding_top", "label": "Üst Boşluk",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Alt Boşluk",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Yorum",
      "settings": [
        {
          "type": "range", "id": "rating", "label": "Yıldız",
          "min": 1, "max": 5, "step": 1, "default": 5
        },
        {
          "type": "textarea", "id": "text", "label": "Yorum Metni",
          "default": "Ürün beklediğimden çok daha kaliteli çıktı. Kargo hızlıydı, paketleme özenliydi. Kesinlikle tavsiye ederim."
        },
        { "type": "text", "id": "name", "label": "İsim", "default": "Ayşe K." },
        { "type": "text", "id": "role", "label": "Etiket", "default": "Doğrulanmış Alışveriş", "info": "Örn: Doğrulanmış Alışveriş, İstanbul" },
        { "type": "image_picker", "id": "avatar", "label": "Fotoğraf (opsiyonel)", "info": "Boşsa isim baş harfli altın rozet gösterilir." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Yorumlar",
      "category": "Text",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}