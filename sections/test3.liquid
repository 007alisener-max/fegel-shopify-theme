{%- comment -%} premium-products.liquid {%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign coll = section.settings.collection -%}

<style>
  .pp-{{ uid }} {
    --pp-accent: {{ section.settings.accent_color }};
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    {%- if section.settings.top_divider %}border-top: 1px solid {{ section.settings.divider_color }};{% endif -%}
  }
  .pp-{{ uid }} .pp-inner {
    /* Mobil kaydirici kenar bosluguna tasabilsin diye degiskene aliyoruz. */
    --pp-pad: {% if section.settings.full_width %}clamp(20px, 3vw, 56px){% else %}20px{% endif %};
    max-width: {% if section.settings.full_width %}none{% else %}1320px{% endif %}; margin: 0 auto; padding: 0 var(--pp-pad);
  }

  /* --- Başlık alanı --- */
  .pp-{{ uid }} .pp-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 24px; margin-bottom: 44px;
  }
  .pp-{{ uid }} .pp-subheading {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 12px; letter-spacing: .25em; text-transform: uppercase; font-weight: 600;
    color: var(--pp-accent); margin-bottom: 14px;
  }
  .pp-{{ uid }} .pp-subheading::before { content: ""; width: 36px; height: 1px; background: var(--pp-accent); opacity: .6; }
  .pp-{{ uid }} .pp-heading {
    font-size: clamp(26px, 3.2vw, 42px); line-height: 1.15; margin: 0;
    color: {{ section.settings.heading_color }};
  }
  .pp-{{ uid }} .pp-viewall {
    display: inline-flex; align-items: center; gap: 10px; flex-shrink: 0;
    font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600;
    color: {{ section.settings.heading_color }}; text-decoration: none;
    padding-bottom: 5px; position: relative; white-space: nowrap;
  }
  .pp-{{ uid }} .pp-viewall::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: 100%;
    background: var(--pp-accent); transform: scaleX(.4); transform-origin: left;
    transition: transform .5s cubic-bezier(.19,1,.22,1);
  }
  .pp-{{ uid }} .pp-viewall:hover::after { transform: scaleX(1); }
  .pp-{{ uid }} .pp-viewall svg { width: 15px; height: 15px; transition: transform .4s ease; }
  .pp-{{ uid }} .pp-viewall:hover svg { transform: translateX(4px); }

  /* --- Grid --- */
  .pp-{{ uid }} .pp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

{%- if section.settings.slider -%}
  /* --- Kaydiricili vitrin ---
     Kartlar kenardan kenara kaysin diye pp-inner'in padding'ini negatif margin'le
     iptal edip ayni degeri iceride geri veriyoruz => ilk kart baslikla hizali baslar,
     son kart sonuna kadar kayar. Yuzde bazli grid-auto-columns, content box'a gore
     cozuldugu icin tam "--pp-cols" kart gorunur genislige oturur. */
  .pp-{{ uid }} .pp-viewport {
    position: relative;
    --pp-cols: {{ section.settings.columns }};
  }
  .pp-{{ uid }} .pp-grid {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--pp-cols) - 1) * {{ section.settings.gap }}px) / var(--pp-cols));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pp-pad);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--pp-pad));
    padding-inline: var(--pp-pad);
    padding-bottom: 2px;
  }
  .pp-{{ uid }} .pp-grid::-webkit-scrollbar { display: none; }
  .pp-{{ uid }} .pp-grid > * { scroll-snap-align: start; }

  /* Ok rayi: yuksekligi TAM olarak bir kartin gorsel alani kadar.
     padding-bottom yuzdesi kendi genisligine gore cozuldugu icin
     kart genisligi x 3/4 aspect-ratio'yu birebir taklit eder; boylece
     oklar JS'siz, her cozunurlukte gorselin tam ortasina oturur.
     (Mutlak konumlu cocugun % referansi rayin PADDING kutusudur.) */
  .pp-{{ uid }} .pp-rail {
    position: absolute; left: 0; right: 0; top: 0; height: 0;
    padding-bottom: calc((100% - (var(--pp-cols) - 1) * {{ section.settings.gap }}px) / var(--pp-cols) * 4 / 3);
    pointer-events: none; z-index: 3;
  }
  .pp-{{ uid }} .pp-arrow {
    position: absolute; pointer-events: auto;
    top: 50%; transform: translateY(-50%);
    width: 46px; height: 46px; border-radius: 999px;
    display: grid; place-items: center; cursor: pointer;
    color: {{ section.settings.heading_color }};
    border: 1px solid {{ section.settings.heading_color }}33;
    background: rgba(255,255,255,.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 6px 22px rgba(0,0,0,.10);
    transition: background .35s ease, color .35s ease, border-color .35s ease,
                opacity .35s ease, transform .5s cubic-bezier(.19,1,.22,1);
  }
  .pp-{{ uid }} .pp-arrow svg { width: 18px; height: 18px; }
  .pp-{{ uid }} .pp-arrow:hover {
    background: var(--pp-accent); color: #fff; border-color: var(--pp-accent);
  }
  .pp-{{ uid }} .pp-arrow:focus-visible { outline: 2px solid var(--pp-accent); outline-offset: 3px; }
  .pp-{{ uid }} .pp-arrow[disabled] { opacity: 0; pointer-events: none; }
  .pp-{{ uid }} .pp-prev { left: calc(var(--pp-pad) * -1 + 6px); }
  .pp-{{ uid }} .pp-next { right: calc(var(--pp-pad) * -1 + 6px); }
  @media (max-width: 989px) {
    .pp-{{ uid }} .pp-arrow { display: none; }
  }
{%- endif -%}

  /* --- Kart --- */
  .pp-{{ uid }} .pp-card { text-decoration: none; display: flex; flex-direction: column; height: 100%; }
  .pp-{{ uid }} .pp-media {
    position: relative; overflow: hidden; isolation: isolate;
    border-radius: {{ section.settings.radius }}px;
    aspect-ratio: 3/4;
    background: rgba(127,127,127,.06);
    margin-bottom: 16px;
  }
  .pp-{{ uid }} .pp-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.2s cubic-bezier(.19,1,.22,1), opacity .7s ease;
  }
  .pp-{{ uid }} .pp-card:hover .pp-media img { transform: scale(1.07); }
  .pp-{{ uid }} .pp-media .pp-img-hover { opacity: 0; }
  .pp-{{ uid }} .pp-card:hover .pp-img-hover { opacity: 1; }

  .pp-{{ uid }} .pp-badge {
    position: absolute; top: 14px; left: 14px; z-index: 2;
    font-size: 10px; letter-spacing: .18em; text-transform: uppercase; font-weight: 700;
    color: #fff; background: var(--pp-accent);
    padding: 7px 12px; border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0,0,0,.18);
  }
  .pp-{{ uid }} .pp-badge.soldout { background: #3a3a3a; }

  .pp-{{ uid }} .pp-info { text-align: {{ section.settings.text_align }}; display: flex; flex-direction: column; flex: 1 1 auto; }
  /* Fiyat + CTA karti altina sabitle => farkli baslik uzunluklarinda fiyatlar hizali kalir */
  .pp-{{ uid }} .pp-price { margin-top: auto; }
  .pp-{{ uid }} .pp-vendor {
    font-size: 11px; letter-spacing: .22em; text-transform: uppercase; font-weight: 600;
    color: var(--pp-accent); margin-bottom: 6px;
  }
  .pp-{{ uid }} .pp-title {
    font-size: 15px; font-weight: 600; line-height: 1.4; margin: 0 0 8px;
    color: {{ section.settings.heading_color }};
    transition: color .3s ease;
  }
  .pp-{{ uid }} .pp-card:hover .pp-title { color: var(--pp-accent); }
  .pp-{{ uid }} .pp-price { font-size: 14px; font-weight: 600; color: {{ section.settings.heading_color }}; }
  .pp-{{ uid }} .pp-price .was {
    text-decoration: line-through; opacity: .45; font-weight: 500; margin-right: 8px;
  }
  .pp-{{ uid }} .pp-price .now.sale { color: var(--pp-accent); }

  .pp-{{ uid }} .pp-cta {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 12px;
    font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 600;
    color: {{ section.settings.heading_color }};
    padding-bottom: 4px; position: relative;
    opacity: 0; transform: translateY(8px);
    transition: opacity .5s ease, transform .55s cubic-bezier(.19,1,.22,1);
  }
  .pp-{{ uid }} .pp-cta::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: 100%;
    background: var(--pp-accent); transform: scaleX(.35); transform-origin: left;
    transition: transform .5s cubic-bezier(.19,1,.22,1);
  }
  .pp-{{ uid }} .pp-card:hover .pp-cta { opacity: 1; transform: translateY(0); }
  .pp-{{ uid }} .pp-card:hover .pp-cta::after { transform: scaleX(1); }
  .pp-{{ uid }} .pp-cta svg { width: 14px; height: 14px; }

  @media (min-width: 990px) and (max-width: 1300px) {
    {%- if section.settings.columns > 4 -%}
    {%- if section.settings.slider -%}
    .pp-{{ uid }} .pp-viewport { --pp-cols: 4; }
    {%- else -%}
    .pp-{{ uid }} .pp-grid { grid-template-columns: repeat(4, 1fr); }
    {%- endif -%}
    {%- endif -%}
  }
  @media (max-width: 989px) {
    {%- if section.settings.slider -%}
    .pp-{{ uid }} .pp-viewport { --pp-cols: 2; }
    {%- else -%}
    .pp-{{ uid }} .pp-grid { grid-template-columns: repeat(2, 1fr); }
    {%- endif -%}
  }
  @media (max-width: 749px) {
    .pp-{{ uid }} { padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px; }
    .pp-{{ uid }} .pp-head { flex-direction: column; align-items: flex-start; gap: 14px; margin-bottom: 30px; }
    /* Mobilde alt alta 2'li grid cok yer kapliyordu => yatay kaydirici.
       Kartlar kenardan kenara kaysin diye pp-inner'in padding'ini negatif
       margin'le iptal edip ayni degeri iceride geri veriyoruz; boylece ilk kart
       basligla hizali baslar, son kart sonuna kadar kayar. */
    .pp-{{ uid }} .pp-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 60%;
      gap: 14px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* scroll-padding olmadan snap, ilk karti padding kenarini yok sayarak
         scrollport'un basina yapistiriyor (scrollLeft 20'de kilitleniyordu) =>
         kart basliktan 20px sola kayiyordu. */
      scroll-padding-inline: var(--pp-pad);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--pp-pad));
      padding-inline: var(--pp-pad);
      padding-bottom: 2px;
    }
    .pp-{{ uid }} .pp-grid::-webkit-scrollbar { display: none; }
    .pp-{{ uid }} .pp-grid > * { scroll-snap-align: start; }
    .pp-{{ uid }} .pp-cta { opacity: 1; transform: none; }
    .pp-{{ uid }} .pp-title { font-size: 13px; }
  }
  {%- if section.settings.head_align == 'center' -%}
  .pp-{{ uid }} .pp-head { flex-direction: column; align-items: center; text-align: center; gap: 16px; }
  .pp-{{ uid }} .pp-subheading::after { content: ""; width: 36px; height: 1px; background: var(--pp-accent); opacity: .6; }
  .pp-{{ uid }} .pp-viewall { margin-top: 2px; }
  {%- endif -%}
</style>

<div class="pp-{{ uid }}">
  <div class="pp-inner">

    <div class="pp-head">
      <div>
        {%- if section.settings.subheading != blank -%}
          <div class="pp-subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pp-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_viewall and coll != blank -%}
        <a href="{{ coll.url }}" class="pp-viewall">
          Tümünü Gör
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="pp-viewport"{% if section.settings.slider %} data-pp-slider data-autoplay="{{ section.settings.autoplay }}"{% endif %}>
    {%- if section.settings.slider -%}
      <div class="pp-rail">
        <button class="pp-arrow pp-prev" type="button" aria-label="Önceki ürünler" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button class="pp-arrow pp-next" type="button" aria-label="Sonraki ürünler">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    {%- endif -%}
    <div class="pp-grid"{% if section.settings.slider %} tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }} ürün listesi"{% endif %}>
      {%- if coll != blank -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          <a href="{{ product.url }}" class="pp-card">
            <div class="pp-media">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 400 }} 400w,
                    {{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 800 }} 800w
                  "
                  sizes="(max-width: 749px) 60vw, {{ 100 | divided_by: section.settings.columns }}vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
                {%- if product.images[1] != blank -%}
                  <img
                    class="pp-img-hover"
                    src="{{ product.images[1] | image_url: width: 800 }}"
                    alt=""
                    width="{{ product.images[1].width }}"
                    height="{{ product.images[1].height }}"
                    loading="lazy"
                  >
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- unless product.available -%}
                <span class="pp-badge soldout">Tükendi</span>
              {%- else -%}
                {%- if product.compare_at_price > product.price -%}
                  {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                  <span class="pp-badge">%{{ discount }} İndirim</span>
                {%- endif -%}
              {%- endunless -%}
            </div>

            <div class="pp-info">
              {%- if section.settings.show_vendor -%}
                <div class="pp-vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <h3 class="pp-title">{{ product.title }}</h3>
              <div class="pp-price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="was">{{ product.compare_at_price | money }}</span>
                  <span class="now sale">{{ product.price | money }}</span>
                {%- else -%}
                  <span class="now">{{ product.price | money }}</span>
                {%- endif -%}
              </div>
              <span class="pp-cta">
                İncele
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pp-card">
            <div class="pp-media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="pp-info">
              <h3 class="pp-title">Örnek Ürün</h3>
              <div class="pp-price"><span class="now">₺0,00</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    </div>

  </div>
</div>

{%- if section.settings.slider -%}
<script>
  (function () {
    var root = document.querySelector('.pp-{{ uid }} [data-pp-slider]');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    var track = root.querySelector('.pp-grid');
    var prev  = root.querySelector('.pp-prev');
    var next  = root.querySelector('.pp-next');
    if (!track) return;

    var azMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function sonaGeldiMi() {
      return track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    }

    function durumGuncelle() {
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = sonaGeldiMi();
    }

    function kaydir(yon) {
      var kart = track.querySelector('.pp-card');
      var adim = kart ? kart.getBoundingClientRect().width + {{ section.settings.gap }} : track.clientWidth;
      /* Gorunen alana tam sigan kart sayisi kadar kaydir. Son kartin sag
         bosluğu olmadigi icin bolum 3.93 gibi cikar => 0.15 tolerans ekleyip
         asagi yuvarliyoruz; mobilde (kartlar %60) 1.57 -> 1 kalir. */
      var n = Math.max(1, Math.floor(track.clientWidth / adim + 0.15));
      var sayfa = n * adim;
      track.scrollBy({ left: yon * sayfa, behavior: azMotion ? 'auto' : 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { kaydir(-1); durdur(); });
    if (next) next.addEventListener('click', function () { kaydir(1);  durdur(); });
    track.addEventListener('scroll', durumGuncelle, { passive: true });
    window.addEventListener('resize', durumGuncelle);

    /* --- Otomatik kayma (opsiyonel) --- */
    var sure = parseFloat(root.dataset.autoplay || '0') * 1000;
    var zaman = null;
    function durdur() { if (zaman) { clearInterval(zaman); zaman = null; } }
    function basla() {
      if (zaman || !sure || azMotion) return;
      zaman = setInterval(function () {
        if (document.hidden) return;
        if (sonaGeldiMi()) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          kaydir(1);
        }
      }, sure);
    }
    if (sure && !azMotion) {
      ['mouseenter', 'focusin', 'touchstart'].forEach(function (e) {
        root.addEventListener(e, durdur, { passive: true });
      });
      ['mouseleave', 'focusout'].forEach(function (e) {
        root.addEventListener(e, basla);
      });
      basla();
    }

    durumGuncelle();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Premium Ürün Vitrini",
  "class": "index-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst Başlık", "default": "Öne Çıkanlar" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Çok Satanlar" },
    { "type": "collection", "id": "collection", "label": "Koleksiyon" },
    {
      "type": "range", "id": "limit", "label": "Gösterilecek Ürün Sayısı",
      "min": 2, "max": 24, "step": 1, "default": 4
    },
    {
      "type": "range", "id": "columns", "label": "Sütun Sayısı (masaüstü)",
      "min": 2, "max": 8, "step": 1, "default": 4
    },
    { "type": "header", "content": "Kaydırma" },
    {
      "type": "checkbox", "id": "slider", "label": "Kaydırmalı vitrin",
      "info": "Açıkken ürünler yan yana kayar; oklarla veya sürükleyerek gezilir. Kaymanın görünmesi için ürün sayısı sütun sayısından fazla olmalı.",
      "default": false
    },
    {
      "type": "range", "id": "autoplay", "label": "Otomatik kayma",
      "info": "0 = kapalı. Fareyle üzerine gelince durur.",
      "min": 0, "max": 10, "step": 1, "unit": "sn", "default": 0
    },
    { "type": "checkbox", "id": "full_width", "label": "Tam Genişlik", "default": false },
    {
      "type": "range", "id": "gap", "label": "Kartlar Arası Boşluk",
      "min": 8, "max": 48, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range", "id": "radius", "label": "Köşe Yuvarlama",
      "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16
    },
    {
      "type": "select", "id": "head_align", "label": "Başlık Hizalama", "default": "left",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" }
      ]
    },
    {
      "type": "select", "id": "text_align", "label": "Kart Yazı Hizalama", "default": "left",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" }
      ]
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Marka Göster", "default": false },
    { "type": "checkbox", "id": "show_viewall", "label": "\"Tümünü Gör\" Linki", "default": true },
    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "section_bg", "label": "Bölüm Arkaplanı", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Yazı Rengi", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Vurgu Rengi", "default": "#b8860b" },
    { "type": "checkbox", "id": "top_divider", "label": "Üst ayrım çizgisi", "default": true },
    { "type": "color", "id": "divider_color", "label": "Ayrım çizgisi rengi", "default": "#ececec" },
    { "type": "header", "content": "Boşluklar" },
    {
      "type": "range", "id": "padding_top", "label": "Üst Boşluk",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range", "id": "padding_bottom", "label": "Alt Boşluk",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    }
  ],
  "presets": [
    { "name": "Premium Ürün Vitrini", "category": "Product" }
  ]
}
{% endschema %}