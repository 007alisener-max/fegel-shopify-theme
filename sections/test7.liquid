{%- comment -%} premium-footer.liquid {%- endcomment -%}

{%- assign uid = section.id -%}

<style>
  .pf-{{ uid }} {
    --pf-accent: {{ section.settings.accent_color }};
    background: {{ section.settings.bg_color }};
    color: rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .75);
    position: relative;
  }
  .pf-{{ uid }}::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, var(--pf-accent), transparent);
    opacity: .5;
  }
  .pf-{{ uid }} .pf-inner {
    max-width: 1320px; margin: 0 auto;
    padding: 70px 20px 0;
  }

  /* --- Üst ızgara --- */
  .pf-{{ uid }} .pf-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat({{ section.blocks.size | at_least: 1 }}, 1fr){% if section.settings.show_contact %} 1.15fr{% endif %} 1.3fr;
    gap: 48px;
    padding-bottom: 54px;
  }

  .pf-{{ uid }} .pf-logo { display: inline-block; margin-bottom: 18px; text-decoration: none; }
  .pf-{{ uid }} .pf-logo img { display: block; width: {{ section.settings.logo_width }}px; height: auto; }
  .pf-{{ uid }} .pf-logo span {
    font-size: 20px; font-weight: 700; letter-spacing: .05em;
    color: {{ section.settings.text_color }};
  }
  .pf-{{ uid }} .pf-about { font-size: 14px; line-height: 1.8; margin: 0 0 22px; max-width: 300px; }

  .pf-{{ uid }} .pf-social { display: flex; gap: 8px; }
  .pf-{{ uid }} .pf-social a {
    width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center;
    color: rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .8);
    border: 1px solid rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .18);
    transition: background .35s ease, border-color .35s ease, color .35s ease, transform .3s ease;
  }
  .pf-{{ uid }} .pf-social a:hover {
    background: var(--pf-accent); border-color: var(--pf-accent); color: #fff;
    transform: translateY(-2px);
  }
  .pf-{{ uid }} .pf-social svg { width: 17px; height: 17px; }

  .pf-{{ uid }} .pf-col-title {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; letter-spacing: .26em; text-transform: uppercase; font-weight: 600;
    color: var(--pf-accent); margin-bottom: 22px;
  }
  .pf-{{ uid }} .pf-col-title::after { content: ""; width: 28px; height: 1px; background: var(--pf-accent); opacity: .6; }

  .pf-{{ uid }} .pf-links { list-style: none; margin: 0; padding: 0; }
  .pf-{{ uid }} .pf-links a {
    display: inline-block; position: relative;
    font-size: 14px; line-height: 2.3; text-decoration: none;
    color: inherit;
    transition: color .3s ease, padding-left .35s cubic-bezier(.19,1,.22,1);
  }
  .pf-{{ uid }} .pf-links a::before {
    content: ""; position: absolute; left: 0; top: 50%; width: 0; height: 1px;
    background: var(--pf-accent);
    transition: width .35s cubic-bezier(.19,1,.22,1);
  }
  .pf-{{ uid }} .pf-links a:hover { color: {{ section.settings.text_color }}; padding-left: 20px; }
  .pf-{{ uid }} .pf-links a:hover::before { width: 12px; }

  /* --- Bülten --- */
  .pf-{{ uid }} .pf-news-text { font-size: 14px; line-height: 1.7; margin: 0 0 18px; }
  .pf-{{ uid }} .pf-news-form {
    display: flex; align-items: center; gap: 8px;
    border-bottom: 1px solid rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .3);
    transition: border-color .4s ease;
  }
  .pf-{{ uid }} .pf-news-form:focus-within { border-color: var(--pf-accent); }
  .pf-{{ uid }} .pf-news-input {
    flex: 1; background: transparent; border: 0; outline: none;
    font-size: 14px; color: {{ section.settings.text_color }};
    padding: 12px 0 14px;
  }
  .pf-{{ uid }} .pf-news-input::placeholder { color: rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .4); }
  .pf-{{ uid }} .pf-news-btn {
    background: transparent; border: 0; cursor: pointer;
    color: var(--pf-accent); display: grid; place-items: center;
    width: 38px; height: 38px; border-radius: 50%;
    transition: background .3s ease, transform .3s ease;
  }
  .pf-{{ uid }} .pf-news-btn:hover { background: rgba(127,127,127,.12); transform: translateX(3px); }
  .pf-{{ uid }} .pf-news-btn svg { width: 18px; height: 18px; }
  .pf-{{ uid }} .pf-news-msg { font-size: 13px; margin-top: 12px; color: var(--pf-accent); }
  .pf-{{ uid }} .pf-news-msg.error { color: #e05c5c; }

  /* --- İletişim --- */
  .pf-{{ uid }} .pf-contact-list { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 15px; }
  .pf-{{ uid }} .pf-contact-item { display: flex; align-items: flex-start; gap: 11px; font-size: 14px; line-height: 1.65; }
  .pf-{{ uid }} .pf-contact-item svg { width: 16px; height: 16px; flex: 0 0 16px; margin-top: 3px; color: var(--pf-accent); }
  .pf-{{ uid }} .pf-contact-item a { color: inherit; text-decoration: none; transition: color .3s ease; }
  .pf-{{ uid }} .pf-contact-item a:hover { color: var(--pf-accent); }
  .pf-{{ uid }} .pf-contact-item strong { color: {{ section.settings.text_color }}; font-weight: 600; display: block; margin-bottom: 2px; }
  .pf-{{ uid }} .pf-dir-btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 24px; border-radius: 8px;
    background: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }};
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600;
    text-decoration: none;
    transition: background .35s ease, transform .3s ease, box-shadow .35s ease;
  }
  .pf-{{ uid }} .pf-dir-btn:hover { background: var(--pf-accent); color: #fff; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.15); }
  .pf-{{ uid }} .pf-dir-btn svg { width: 15px; height: 15px; }

  /* --- Alt bar --- */
  .pf-{{ uid }} .pf-bottom {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 24px 0 28px;
    border-top: 1px solid rgba({{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }}, .1);
    font-size: 12px; letter-spacing: .06em;
  }
  .pf-{{ uid }} .pf-payments { display: flex; gap: 6px; flex-wrap: wrap; }
  .pf-{{ uid }} .pf-payments svg { width: 36px; height: 24px; opacity: .8; }

  /* --- Yasal linkler --- */
  .pf-{{ uid }} .pf-legal { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; }
  .pf-{{ uid }} .pf-legal a { color: inherit; text-decoration: none; opacity: .8; transition: opacity .3s ease, color .3s ease; }
  .pf-{{ uid }} .pf-legal a:hover { opacity: 1; color: var(--pf-accent); }

  /* --- Başa dön --- */
  .pf-{{ uid }} .pf-top {
    position: absolute; top: -24px; right: 40px;
    width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: var(--pf-accent); color: #fff; border: 0;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transition: transform .35s cubic-bezier(.19,1,.22,1), box-shadow .35s ease;
  }
  .pf-{{ uid }} .pf-top:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,.35); }
  .pf-{{ uid }} .pf-top svg { width: 18px; height: 18px; }

  @media (max-width: 989px) {
    .pf-{{ uid }} .pf-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 28px; }
  }
  @media (max-width: 749px) {
    .pf-{{ uid }} .pf-inner { padding-top: 54px; }
    .pf-{{ uid }} .pf-grid { grid-template-columns: 1fr; gap: 34px; padding-bottom: 40px; }
    .pf-{{ uid }} .pf-bottom { flex-direction: column; text-align: center; gap: 14px; }
    .pf-{{ uid }} .pf-top { right: 20px; }
  }
</style>

<footer class="pf-{{ uid }}" id="PfFooter-{{ uid }}">
  <button class="pf-top" aria-label="Başa dön" data-pf-top>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
  </button>

  <div class="pf-inner">
    <div class="pf-grid">

      {%- comment -%} Marka sütunu {%- endcomment -%}
      <div>
        <a href="{{ routes.root_url }}" class="pf-logo">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy">
          {%- else -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.about != blank -%}
          <p class="pf-about">{{ section.settings.about }}</p>
        {%- endif -%}
        <div class="pf-social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook != blank -%}
            <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 8h3V5h-3a4 4 0 0 0-4 4v2H7v3h3v7h3v-7h3l1-3h-4V9a1 1 0 0 1 1-1Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube != blank -%}
            <a href="{{ section.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="6" width="19" height="12" rx="4"/><path d="m10 9.5 5 2.5-5 2.5v-5Z" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.whatsapp != blank -%}
            <a href="{{ section.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M9 8.5c0 4 2.5 6.5 6.5 6.5l1-2-2.2-1.1-1 .8c-1.2-.6-1.8-1.2-2.4-2.4l.8-1L10.5 7l-1.5 1.5Z" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Menü sütunları {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div class="pf-col-title">{{ block.settings.heading }}</div>
          {%- if block.settings.menu != blank -%}
            {%- assign _fhide = block.settings.hidden_titles | default: '' | downcase | replace: ', ', ',' | replace: ' ,', ',' | strip | prepend: ',' | append: ',' -%}
            <ul class="pf-links">
              {%- for link in block.settings.menu.links -%}
                {%- assign _fprobe = link.title | downcase | strip | prepend: ',' | append: ',' -%}
                {%- if _fhide contains _fprobe -%}{%- continue -%}{%- endif -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} İletişim {%- endcomment -%}
      {%- if section.settings.show_contact -%}
        <div>
          <div class="pf-col-title">{{ section.settings.contact_heading }}</div>
          <ul class="pf-contact-list">
            {%- if section.settings.phone1 != blank or section.settings.phone2 != blank -%}
              <li class="pf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
                <span>
                  {%- if section.settings.phone1 != blank -%}<a href="tel:{{ section.settings.phone1 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">{{ section.settings.phone1 }}</a>{%- endif -%}
                  {%- if section.settings.phone2 != blank -%}<br><a href="tel:{{ section.settings.phone2 | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">{{ section.settings.phone2 }}</a>{%- endif -%}
                </span>
              </li>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <li class="pf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.address != blank -%}
              <li class="pf-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <span>{%- if section.settings.address_title != blank -%}<strong>{{ section.settings.address_title }}</strong>{%- endif -%}{{ section.settings.address | escape | newline_to_br }}</span>
              </li>
            {%- endif -%}
          </ul>
          {%- if section.settings.maps_url != blank -%}
            <a href="{{ section.settings.maps_url }}" target="_blank" rel="noopener" class="pf-dir-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s7-6.5 7-11a7 7 0 1 0-14 0c0 4.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {{ section.settings.dir_btn_text | default: 'Yol Tarifi Al' }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Bülten {%- endcomment -%}
      {%- if section.settings.show_newsletter -%}
        <div>
          <div class="pf-col-title">{{ section.settings.newsletter_heading }}</div>
          <p class="pf-news-text">{{ section.settings.newsletter_text }}</p>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="pf-news-form">
              <input
                type="email"
                name="contact[email]"
                class="pf-news-input"
                placeholder="E-posta adresiniz"
                autocomplete="email"
                aria-label="E-posta adresiniz"
                required
              >
              <button type="submit" class="pf-news-btn" aria-label="Abone ol">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <div class="pf-news-msg">Teşekkürler! Aboneliğiniz alındı.</div>
            {%- elsif form.errors -%}
              <div class="pf-news-msg error">Lütfen geçerli bir e-posta adresi girin.</div>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

    </div>

    <div class="pf-bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tüm hakları saklıdır.</div>

      {%- comment -%} Yasal linkler: mevcut politikalar + varsa sözleşme sayfaları (yoksa gizlenir) {%- endcomment -%}
      <div class="pf-legal">
        {%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | default: 'Gizlilik Politikası' }}</a>{%- endif -%}
        {%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | default: 'İade Politikası' }}</a>{%- endif -%}
        {%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | default: 'Kullanım Koşulları' }}</a>{%- endif -%}
        {%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | default: 'Teslimat Politikası' }}</a>{%- endif -%}
        {%- assign _p_ms = pages['mesafeli-satis-sozlesmesi'] -%}
        {%- if _p_ms.url != blank -%}<a href="{{ _p_ms.url }}">{{ _p_ms.title }}</a>{%- endif -%}
        {%- assign _p_ob = pages['on-bilgilendirme-formu'] -%}
        {%- if _p_ob.url != blank -%}<a href="{{ _p_ob.url }}">{{ _p_ob.title }}</a>{%- endif -%}
        {%- assign _p_kvkk = pages['kvkk'] -%}
        {%- if _p_kvkk.url != blank -%}<a href="{{ _p_kvkk.url }}">{{ _p_kvkk.title }}</a>{%- endif -%}
        {%- assign _p_teslimat = pages['teslimat-ve-kargo'] -%}
        {%- if _p_teslimat.url != blank -%}<a href="{{ _p_teslimat.url }}">{{ _p_teslimat.title }}</a>{%- endif -%}
      </div>

      {%- if section.settings.show_payments -%}
        <div class="pf-payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function () {
    var root = document.getElementById('PfFooter-{{ uid }}');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    root.querySelector('[data-pf-top]').addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Premium Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "range", "id": "logo_width", "label": "Logo Genişliği",
      "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140
    },
    { "type": "textarea", "id": "about", "label": "Marka Açıklaması", "default": "Kalite ve konforu bir araya getiren ürünlerimizle hayatınızı kolaylaştırıyoruz." },
    { "type": "header", "content": "Sosyal Medya" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp", "info": "Örn: https://wa.me/905xxxxxxxxx" },
    { "type": "header", "content": "İletişim" },
    { "type": "checkbox", "id": "show_contact", "label": "İletişim Alanı Göster", "default": true },
    { "type": "text", "id": "contact_heading", "label": "Başlık", "default": "İletişim" },
    { "type": "text", "id": "phone1", "label": "Telefon 1", "default": "+90 (216) 504 30 51" },
    { "type": "text", "id": "phone2", "label": "Telefon 2", "default": "+90 (533) 576 08 01" },
    { "type": "text", "id": "email", "label": "E-posta", "default": "info@fegelcomfort.com" },
    { "type": "text", "id": "address_title", "label": "Adres Başlığı", "default": "Quant Plaza B" },
    { "type": "textarea", "id": "address", "label": "Adres", "default": "Şerifali Mah. Turgut Özal Bulvarı No: 154/27\nÜmraniye / İstanbul, Türkiye" },
    { "type": "text", "id": "maps_url", "label": "Yol Tarifi Linki (Google Maps)", "info": "Google Haritalar'da adresi açıp linki buraya yapıştırın.", "default": "https://www.google.com/maps/dir/?api=1&destination=%C5%9Eerifali%20Mah.%20Turgut%20%C3%96zal%20Bulvar%C4%B1%20No%20154%2F27%20%C3%9Cmraniye%20%C4%B0stanbul" },
    { "type": "text", "id": "dir_btn_text", "label": "Yol Tarifi Buton Metni", "default": "Yol Tarifi Al" },
    { "type": "header", "content": "Bülten" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Bülten Kaydı Göster", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Bülten Başlığı", "default": "Bülten" },
    { "type": "textarea", "id": "newsletter_text", "label": "Bülten Metni", "default": "Yeni ürünler ve kampanyalardan ilk siz haberdar olun." },
    { "type": "header", "content": "Alt Bar" },
    { "type": "checkbox", "id": "show_payments", "label": "Ödeme İkonları", "default": true },
    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "bg_color", "label": "Arkaplan", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Yazı Rengi", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Vurgu Rengi", "default": "#b8860b" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menü Sütunu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Sütun Başlığı", "default": "Kategoriler" },
        { "type": "link_list", "id": "menu", "label": "Menü" },
        { "type": "text", "id": "hidden_titles", "label": "Gizlenecek başlıklar", "info": "Virgülle ayır. Örn: Proje, Bayi Talep Formu" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Premium Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}